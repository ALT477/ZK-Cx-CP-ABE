[Unit]
Description=IoToDChain FastAPI backend
After=network.target

[Service]
Type=simple
User=iotodchain
Group=iotodchain
WorkingDirectory=/opt/iotodchain
Environment="PATH=/opt/iotodchain/venv/bin"
Environment="SMS_PROVIDER=gateway_queue"
ExecStart=/opt/iotodchain/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --root-path /iotodchain
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
